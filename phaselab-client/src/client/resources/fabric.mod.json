{
  "schemaVersion": 1,
  "id": "phaselab",
  "version": "5.1.0",
  "name": "PhaseLab Easy Red Team",
  "description": "Fabric 1.21.11 telemetry plus bounded active vehicle tests enabled by one server command. No copied keys, server IDs, or manual client configuration.",
  "authors": ["Denis + OpenAI"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.denis.phaselab.PhaseTelemetryClient",
      "dev.denis.phaselab.PhaseLabLockedClient"
    ]
  },
  "mixins": [
    "phaselab.client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
